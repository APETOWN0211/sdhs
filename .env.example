# ========================================
# ROLL ON! - Environment Variables (example)
# 실제 값은 절대 커밋하지 마세요.
# ========================================

# Supabase Project URL (Settings → API → Project URL)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key (Settings → API → Project API keys → anon public)
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service_role key (서버 전용, 절대 클라이언트 번들에 노출 금지)
# Nuxt 서버 라우트에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
